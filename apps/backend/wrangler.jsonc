{
  "name": "understudy-backend",
  // Without this, every non-interactive wrangler command against an operator
  // with more than one account exits on "More than one account available".
  // `wrangler tail` does so writing NOTHING to stdout, which reads exactly like
  // a healthy tail observing no traffic — a production misdiagnosis was built
  // on that silence once. Pinning the account makes the failure impossible.
  "account_id": "056cbaa6f5c3d8ff5584f1aa84bbe050",
  "main": "src/index.ts",
  // The production address consumers are configured with. A `*.workers.dev`
  // subdomain is tied to one operator's account name, which is the wrong
  // identity for a service other repositories depend on — and Metamind's
  // SWEEP_CRON could not reach the workers.dev host at all (see
  // docs/unattended-production-rollout.md), while its fetch-path calls to the
  // same URL succeeded.
  //
  // MUST stay explicit. Wrangler disables workers.dev by default as soon as a
  // route is declared and the key is absent, which silently retires the old
  // hostname — and consumers are configured with a URL, so a consumer still
  // pointed at it breaks the moment this deploys. Kept on so the cutover is
  // additive; removing it is a separate, deliberate step once no consumer
  // resolves the old name.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "understudy.proofof.tech",
      "custom_domain": true
    }
  ],
  // Load-bearing for local dev, not cosmetic. With the custom_domain route
  // above declared, `wrangler dev` rewrites the URL the Worker SEES to
  // http://understudy.proofof.tech/... whatever the client asked for — so the
  // account plane's canonical-origin guard (src/index.ts) sees a non-https
  // canonical host, fails its loopback exemption, and 308s every
  // /dashboard, /oauth and /mcp request to https on a plaintext listener.
  // Pinning the dev host restores the hostname the exemption tests for.
  // Verify by curling the dev server; a vitest run cannot see this, because
  // in-process `new Request("http://localhost:8787/...")` is precisely the URL
  // wrangler dev never produces.
  //
  // Trade-off, and the next person's trap: this breaks `wrangler dev --remote`,
  // which resolves a zone from the host and cannot find one for a single-label
  // "localhost". That is the only documented way to exercise real EMAIL sends
  // (see `send_email` below), so reach for it as
  // `wrangler dev --remote --host understudy.proofof.tech` — the CLI arg wins
  // over this key, and remote mode forces https, so the guard passes.
  "dev": { "host": "localhost" },
  // Pinned at-or-before the pinned wrangler release date (see package.json)
  // so the bundled workerd is guaranteed to recognize this compatibility date.
  "compatibility_date": "2026-07-01",
  // Agents SDK Durable Objects require Node.js compatibility.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      // One SessionAgent DO per sessionId (per tenant/case) - DL-006.
      // SessionAgent itself lands in src/session.ts at M-004 (wired into the
      // Worker entry, src/index.ts, at M-005); the binding is declared now
      // so wrangler.jsonc doesn't churn again for that milestone.
      { "name": "SESSION", "class_name": "SessionAgent" },
      { "name": "DEVICE", "class_name": "DeviceAgent" },
      { "name": "TENANT_CONTROL", "class_name": "TenantDeviceCoordinator" },
      // Singleton account store (users/devices/tokens/OTP/pairing). All
      // /agents/* exposure of this binding is closed by the deny-by-default
      // agent-path gate in src/index.ts.
      { "name": "ACCOUNT_DIRECTORY", "class_name": "AccountDirectory" },
      // One MCP transport DO per MCP connection (McpAgent.serve names them).
      { "name": "MCP_AGENT", "class_name": "UnderstudyMcp" },
      // One AccountAgent per tenant: MCP session binding + ref guard + the
      // one-command-at-a-time mutex. Also closed at /agents/* by the gate.
      { "name": "ACCOUNT", "class_name": "AccountAgent" }
    ]
  },
  "migrations": [
    // Agents SDK Durable Objects are SQLite-backed.
    { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DeviceAgent", "TenantDeviceCoordinator"]
    },
    { "tag": "v3", "new_sqlite_classes": ["AccountDirectory"] },
    { "tag": "v4", "new_sqlite_classes": ["UnderstudyMcp", "AccountAgent"] }
  ],
  "kv_namespaces": [
    {
      // Credential vault ciphertext store: fill_secret's secretRef ->
      // AES-256-GCM envelope (src/vault.ts; seed with scripts/vault-put.mjs
      // - never `wrangler kv key put` a raw plaintext). Resolution is
      // service-side (secrets.ts via vault.ts) and the plaintext is never
      // logged or written to DO state (DL-004). A KV namespace gives the
      // dynamic get-by-key lookup an arbitrary per-fill secretRef needs;
      // CF's Secrets / Secrets Store bindings are static (one binding per
      // fixed secret name) and cannot address a runtime-chosen key. A
      // per-tenant external KMS remains a possible future swap behind the
      // same Env.VAULT seam (src/types.ts).
      "binding": "VAULT",
      // Created 2026-07-17 via `wrangler kv namespace create VAULT` on the
      // production account (see README "Deploy"). Namespace ids are not
      // secrets; the values inside are ciphertext envelopes regardless.
      "id": "b6168345442644e3ac24ef4c43dd7f1e"
    },
    {
      // @cloudflare/workers-oauth-provider's grant/token/client store (the
      // binding name is fixed by the library). Holds only hashed tokens and
      // encrypted props by the library's own design. Created 2026-07-30 via
      // `wrangler kv namespace create OAUTH_KV`.
      "binding": "OAUTH_KV",
      "id": "920a2498651c4cb498a2089184b96c78"
    }
  ],
  "secrets": {
    // AUTH_HMAC_SECRET signs/verifies server-minted sessionIds so
    // scopeSession can verify tenant ownership statelessly (M-006, DL-008).
    // VAULT_MASTER_KEY (base64url, 32 bytes) envelope-encrypts every vault
    // value; without it a KV read-back at rest yields only ciphertext.
    // CALLER_TOKENS / EXTENSION_TOKENS must be listed as well: when `secrets`
    // is declared, wrangler loads ONLY the listed keys from .dev.vars and
    // excludes the rest (no "optional" tier exists), which silently breaks
    // dev auth. They are operationally required anyway - without them the
    // service 401s every caller and rejects the extension WS.
    "required": [
      "AUTH_HMAC_SECRET",
      "CALLER_TOKENS",
      "EXTENSION_TOKENS",
      "DEVICE_TOKENS",
      "WS_TICKET_SECRET",
      "VAULT_MASTER_KEY",
      // base64url PKCS#8 P-256 private key for the dashboard's client-side
      // vault-secret upload (§ vault-upload.ts). Listing it here is load-
      // bearing twice over: deploys fail without it, and — because this key
      // is also the .dev.vars allowlist — omitting it there would silently
      // drop it in dev.
      "VAULT_UPLOAD_PRIVATE_KEY"
    ]
  },
  // Transactional email (sign-in OTPs) via Cloudflare Email Sending; the
  // proofof.tech domain is onboarded (wrangler email sending list). In local
  // dev the binding needs `wrangler dev --remote` to actually send.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "QUOTA_POLICY": "{\"sessionCreatesPerActorMinute\":10,\"commandsPerSessionMinute\":120,\"commandsPerTenantMinute\":600,\"credentialFillsPerActorMinute\":30,\"deviceTicketsPerDeviceMinute\":30,\"sessionCommandCap\":10000}",
    // Gates ONLY the unattended create branch (src/api/sessions.ts); a request
    // with an empty body returns from the attended branch above that gate, so
    // attended callers never reach it. This is the live blast-radius control
    // for unattended traffic: named tenants or an explicit "prefix:" class.
    // "prefix:acct-" is the self-serve account class minted by
    // AccountDirectory — MCP-driven browsing IS the unattended flow, so the
    // class must be listed here for MCP to work at all. enabledForTenant no
    // longer honours "*" (a wildcard would admit every tenant holding a
    // caller token; the docs forbid it, so the code no longer carries it).
    "UNATTENDED_ENABLED_TENANTS": "[\"metamind\", \"prefix:acct-\"]",
    // On the LEGACY command path this flag is the only thing refusing a
    // protocol-1 write — `dispatch()` in src/session.ts does not check the
    // protocol version, so with this empty the write executes. Only `dispatchV2`
    // refuses one, and the legacy path is by definition the path that does not
    // reach it. Do not read this as redundant with dispatchV2.
    //
    // That path is reached only when ALL of: the caller omits
    // `understudy-command-contract: 2`, the session is attended, and the
    // extension is protocol-1. @understudy/connector has sent that header
    // unconditionally since 0.5.0, so a consumer on a current connector never
    // gets there — this guards a caller on an older one, or a hand-rolled POST.
    // Enable it for a tenant (or class) whenever that tenant is enabled above.
    //
    // Note re MCP: the "prefix:acct-" entry is defence-in-depth only. MCP
    // always dispatches with contractV2:true (account-agent.ts), so its writes
    // are protected by dispatchV2's protocol-2 requirement, not by this flag —
    // and an acct- tenant holds no CALLER_TOKENS entry, so it cannot reach the
    // legacy branch at all. The entry keeps the two allowlists symmetric and
    // guards against any future non-MCP acct- caller.
    "SAFE_WRITE_REQUIRED_TENANTS": "[\"metamind\", \"prefix:acct-\"]"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "understudy_telemetry"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
